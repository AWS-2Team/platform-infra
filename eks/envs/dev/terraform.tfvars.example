aws_region   = "ap-northeast-2"
aws_profile  = "tf-user"
project_name = "petclinic-dev"

network_state_bucket = "Your-state-bucket-name"
network_state_key    = "last-lab/dev/network/terraform.tfstate"
network_state_region = "ap-northeast-2"

cluster_version             = "1.36"
eks_endpoint_public_access  = true
eks_endpoint_private_access = true
eks_authentication_mode     = "API_AND_CONFIG_MAP"
eks_node_instance_types     = ["t3.medium"]
eks_node_capacity_type      = "ON_DEMAND"
eks_node_min_size           = 1
eks_node_desired_size       = 1
eks_node_max_size           = 2

tags = {
  Environment = "dev"
}


